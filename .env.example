# Discord Bot Configuration
# Copy this file to .env and fill in your values
# Note: config.json takes precedence if both are present

# =============================================================================
# Discord Bot Token (Required)
# =============================================================================
# Get this from: https://discord.com/developers/applications > Your App > Bot
DISCORD_TOKEN=your_discord_bot_token_here

# =============================================================================
# Discord Server IDs
# =============================================================================
# To get IDs: Enable Developer Mode in Discord (Settings > Advanced)
# Then right-click channels/roles/server to "Copy ID"

# Category where ticket channels will be created
TICKET_CATEGORY_ID=

# Optional: Category for archived/closed tickets
TICKET_ARCHIVE_CATEGORY_ID=

# =============================================================================
# LarpManager API Configuration
# =============================================================================
# Your LarpManager instance URL (no trailing slash)
LARPMANAGER_API_URL=https://your-larpmanager.com

# API key created in LarpManager (PublisherApiKey model)
LARPMANAGER_API_KEY=your_api_key_here

# =============================================================================
# Optional Settings
# =============================================================================
# Maximum open tickets per user (default: 5, 0 = unlimited)
MAX_TICKETS_PER_USER=5

# API request timeout in seconds (default: 30)
API_TIMEOUT=30

# Auto-close inactive tickets after X hours (default: 0 = disabled)
AUTO_CLOSE_HOURS=0
